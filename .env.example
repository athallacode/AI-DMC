POSTGRES_DB=ai_dmc
POSTGRES_USER=ai_dmc
POSTGRES_PASSWORD=local-development-only-change-me
DATABASE_URL=postgresql+psycopg://ai_dmc:local-development-only-change-me@db:5432/ai_dmc
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CONFIDENCE_THRESHOLD=0.85
PIPELINE_MODE=mock
STORAGE_DIR=/app/storage
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
APP_ENVIRONMENT=development
JWT_EXPIRE_MINUTES=60
SEED_PASSWORD=change-this-local-demo-password
PIPELINE_IMPORT=app.integrations.real:process_document
TAXONOMY_PATH=/app/pipeline/config/taxonomy.json
# Pipeline Orang 1; gunakan localhost:11434 untuk backend tanpa Docker.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=180
PIPELINE_VOTES=3
